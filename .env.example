# ============================================================
# 文件名：.env.example
# 作用：环境变量配置模板。复制为 .env 后填写真实值使用。
# 对应规范：SPEC.md §5.1 配置项定义、§5.2 .env.example 规范
# 说明：
#   - 变量名必须与 .env 完全一致；密钥留空或示例占位
#   - .env 严禁提交到 Git，.env.example 必须提交
#   - 聊天与 Embedding 分属两家 OpenAI 兼容服务商，故拆为
#     CHAT_* 与 EMBEDDING_* 两组独立配置（SPEC §2.3 设计原则 2）
#   - 示例组合：聊天用 DeepSeek（官方不提供 Embedding 接口），
#     Embedding 用阿里云百炼 qwen3.7-text-embedding-flash
# ============================================================

DATABASE_URL=postgresql+psycopg://raguser:change_this_password@localhost:5433/enterprise_rag

# ---- 聊天模型（DeepSeek，OpenAI 兼容）----
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=sk-729c7bc616f544ab8c2abaed1bbd99a1
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，
#       请使用 deepseek-v4-flash（或 deepseek-v4-pro）
CHAT_MODEL=deepseek-v4-flash

# ---- Embedding（阿里云百炼 DashScope，OpenAI 兼容）----
# 模型：qwen3.7-text-embedding-flash，支持 256/512/768/1024 维，默认 1024
# 备选：qwen3.7-text-embedding（256~2560 维）/ text-embedding-v4 / text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-ws-H.PPIEDML.2C69.MEUCIQCk8cQIH14b8G9bK4Jr63KRbhUYS9iZHGKdVheB2Hrp7AIgWJpzbHRU7g2I2_jYnD2_-LUmSvvUQml0eA2fpTXHlNI
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 注意：维度必须等于所选 Embedding 模型实际输出维度，
#       否则数据库建表/向量入库会失败（SPEC §5.1）
EMBEDDING_DIMENSION=1024

UPLOAD_DIR=storage/uploads
